generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  hr
  employee
}

enum UserStatus {
  active
  inactive
  suspended
}

enum AttendanceStatus {
  present
  late
  absent
}

enum LeaveRequestStatus {
  pending
  approved
  rejected
  cancelled
}

enum PayrollStatus {
  draft
  finalized
  paid
}

enum NotificationType {
  leave
  payroll
  attendance
  system
}

enum DocumentType {
  employee
  payroll
  leave
  other
}

enum AiSeverity {
  low
  medium
  high
  critical
}

enum AiExceptionStatus {
  open
  investigating
  resolved
  ignored
}

model User {
  id              String     @id @default(uuid())
  employeeId      String     @unique @map("employee_id")
  email           String     @unique
  passwordHash    String     @map("password_hash")
  role            UserRole   @default(employee)
  isEmailVerified Boolean    @default(false) @map("is_email_verified")
  status          UserStatus @default(active)
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  profile            EmployeeProfile?
  attendanceRecords  AttendanceRecord[]
  leaveRequests      LeaveRequest[]
  leaveBalances      LeaveBalance[]
  payrolls           Payroll[]
  notifications      Notification[]
  documents          Document[]
  auditLogs          AuditLog[]         @relation("AuditActor")
  reportedExceptions AiException[]      @relation("ExceptionReporter")
  assignedExceptions AiException[]      @relation("ExceptionAssignee")
  ownedExceptions    AiException[]      @relation("ExceptionUser")

  @@map("users")
}

model EmployeeProfile {
  id            String    @id @default(uuid())
  userId        String    @unique @map("user_id")
  fullName      String    @map("full_name")
  phone         String?
  address       String?
  department    String?
  designation   String?
  dateOfJoining DateTime? @map("date_of_joining")
  managerName   String?   @map("manager_name")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("employee_profiles")
}

model AttendanceRecord {
  id           String           @id @default(uuid())
  userId       String           @map("user_id")
  date         DateTime
  checkInTime  DateTime?        @map("check_in_time")
  checkOutTime DateTime?        @map("check_out_time")
  status       AttendanceStatus
  remarks      String?

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, date])
  @@index([userId, date], map: "attendance_records_user_id_date_idx")
  @@map("attendance_records")
}

model LeaveType {
  id               String  @id @default(uuid())
  name             String  @unique
  code             String  @unique
  description      String?
  annualAllocation Decimal @default(0) @map("annual_allocation") @db.Decimal(12, 2)
  isPaid           Boolean @default(true) @map("is_paid")
  isActive         Boolean @default(true) @map("is_active")

  balances LeaveBalance[]
  requests LeaveRequest[]

  @@map("leave_types")
}

model LeaveBalance {
  id          String  @id @default(uuid())
  userId      String  @map("user_id")
  leaveTypeId String  @map("leave_type_id")
  year        Int
  allocated   Decimal @default(0) @db.Decimal(12, 2)
  used        Decimal @default(0) @db.Decimal(12, 2)

  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  @@unique([userId, leaveTypeId, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id              String             @id @default(uuid())
  userId          String             @map("user_id")
  leaveTypeId     String             @map("leave_type_id")
  startDate       DateTime           @map("start_date")
  endDate         DateTime           @map("end_date")
  days            Decimal            @db.Decimal(12, 2)
  remarks         String?
  status          LeaveRequestStatus @default(pending)
  decisionComment String?            @map("decision_comment")
  decidedAt       DateTime?          @map("decided_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  @@map("leave_requests")
}

model Payroll {
  id         String        @id @default(uuid())
  userId     String        @map("user_id")
  year       Int
  month      Int
  baseSalary Decimal       @map("base_salary") @db.Decimal(12, 2)
  allowances Decimal       @default(0) @db.Decimal(12, 2)
  deductions Decimal       @default(0) @db.Decimal(12, 2)
  netPay     Decimal       @map("net_pay") @db.Decimal(12, 2)
  status     PayrollStatus @default(draft)
  payDate    DateTime?     @map("pay_date")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  salarySlip SalarySlip?

  @@unique([userId, year, month])
  @@map("payrolls")
}

model SalarySlip {
  id          String   @id @default(uuid())
  payrollId   String   @unique @map("payroll_id")
  slipNumber  String   @unique @map("slip_number")
  fileUrl     String?  @map("file_url")
  generatedAt DateTime @default(now()) @map("generated_at")

  payroll Payroll @relation(fields: [payrollId], references: [id], onDelete: Restrict)

  @@map("salary_slips")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Document {
  id        String       @id @default(uuid())
  userId    String       @map("user_id")
  title     String
  type      DocumentType
  url       String
  metadata  Json?
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("documents")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String?  @map("actor_id")
  action      String
  entity      String
  entityId    String   @map("entity_id")
  beforeState Json?    @map("before_state")
  afterState  Json?    @map("after_state")
  createdAt   DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model AiException {
  id                 String            @id @default(uuid())
  userId             String?           @map("user_id")
  severity           AiSeverity
  status             AiExceptionStatus @default(open)
  category           String
  title              String
  description        String?
  evidence           Json?
  deterministicFacts Json?             @map("deterministic_facts")
  reportedById       String?           @map("reported_by_id")
  assignedToId       String?           @map("assigned_to_id")
  resolvedAt         DateTime?         @map("resolved_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  user       User? @relation("ExceptionUser", fields: [userId], references: [id], onDelete: SetNull)
  reportedBy User? @relation("ExceptionReporter", fields: [reportedById], references: [id], onDelete: SetNull)
  assignedTo User? @relation("ExceptionAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([status, severity], map: "ai_exceptions_status_severity_idx")
  @@map("ai_exceptions")
}
